---
// Hue9's site: overview, privacy and terms in the six languages of the app.
// Its look follows the app's own art direction (Hue9/Marketing/AppStore-Concepts-V2):
// bold colour blocks, big sans type and boards painted with the app's real palettes.
// App copy comes from the app's Localizable.xcstrings (src/data/hue9-app.json);
// legal and accessibility texts from the original /hue9-legal and /hue9-accessibility pages (src/data/hue9.json).
import '@fontsource-variable/inter';
import AppPage from '../../layouts/AppPage.astro';
import { HUE9_LANGS, appPaths } from '../../data/appSites';
import LegalDoc from '../../components/LegalDoc.astro';
import Board from '../../components/hue9/Board.astro';
import Symbol from '../../components/hue9/Symbol.astro';
import data from '../../data/hue9.json';
import appText from '../../data/hue9-app.json';
import { PALETTES } from '../../data/hue9Palettes';
import { apps } from '../../data/apps';

export const getStaticPaths = () => appPaths(HUE9_LANGS);

const { lang, page } = Astro.props as { lang: keyof typeof data.common; page: string };
const t = data.common[lang];
const hub = data.hub[lang];
const a = data.a11y[lang] as Record<string, string>;
const x = appText[lang as keyof typeof appText] as Record<string, string>;
const hue9 = apps.find((app) => app.name === 'Hue9')!;
const base = `/hue9/${lang === 'en' ? '' : `${lang.toLowerCase()}/`}`;
const a11yHref = `/hue9-accessibility/?lang=${lang}`;
const mail = (subject: string) => `mailto:davidcafor@gmail.com?subject=${encodeURIComponent(`Hue9 ${subject}`)}`;

const nav = [
  { label: t.navPrivacy, href: `${base}privacy/` },
  { label: t.navTerms, href: `${base}terms/` },
  { label: t.navAccessibility, href: a11yHref },
];

// Legal documents keep their numbered sections (p1Title/p1Body…).
const doc = page && ((page === 'privacy/' ? data.privacy[lang] : data.terms[lang]) as Record<string, string>);
const sections = doc
  ? Array.from({ length: 10 }, (_, i) => i + 1)
      .filter((n) => doc[`p${n}Title`])
      .map((n) => ({ title: doc[`p${n}Title`], html: doc[`p${n}Body`] }))
  : [];
const strip = (s: string) => s.replace(/<br>/g, ' ');

// The Daily Grid date is the build date; the site is rebuilt every morning.
const now = new Date();
const day = String(now.getUTCDate()).padStart(2, '0');
const dateLabel = new Intl.DateTimeFormat(lang, { month: 'long', weekday: 'long', timeZone: 'UTC' }).format(now);

const difficulties = ['easy', 'medium', 'hard', 'expert'].map((k) => x[`difficulty.${k}`]);
const themes = (['rams', 'vanguard', 'obsidian', 'spectrum'] as const).map((k, i) => ({ key: k, name: x[`theme.${k}`], seed: i + 7 }));
const access = ['symbols', 'voice', 'text', 'motion', 'contrast'].map((k) => ({ title: a[`${k}Title`], body: a[`${k}Body`] }));
const pro = ['endless', 'themes', 'competition', 'one_time'].map((k) => ({
  title: x[`paywall.feature.${k}.title`],
  body: x[`paywall.feature.${k}.body`],
}));
pro.splice(1, 0, { title: x['daily_grid.title'], body: x['paywall.feature.daily_grid.body'] });
const tools = [
  { title: x['game.controls.hint'], body: x['learning.tools.hint.body'] },
  { title: x['game.controls.pencil'], body: x['game.controls.pencil_hint'] },
];
const rams = PALETTES.rams.light.game;
---

<AppPage
  title={doc ? doc.pageTitle : `Hue9 — ${x['onboarding.welcome.title']}`}
  description={doc ? doc.pageDescription : strip(x['onboarding.welcome.body'])}
  app="hue9"
  {lang}
  langs={HUE9_LANGS}
  {page}
  {nav}
  accent={{ light: '#e06a52', dark: '#f4866f' }}
  skin="skin-hue9"
>
  {
    doc ? (
      <LegalDoc
        eyebrow={doc.heroEyebrow}
        title={doc.heroTitle}
        intro={doc.heroIntro}
        chips={[doc.updated, doc.noTracking ?? doc.oneTime, doc.applies].filter(Boolean)}
        summary={[1, 2, 3].map((n) => ({ title: doc[`summary${n}Title`], body: doc[`summary${n}Body`] }))}
        notice={doc.notice}
        tocLabel={t.tableOfContents}
        {sections}
      />
    ) : (
      <div class="h9">
        <section class="panel hero">
          <div class="copy">
            <p class="tag">
              <img src={hue9.icon} alt="" width="44" height="44" />
              Hue9
            </p>
            <h1>{x['onboarding.welcome.title']}</h1>
            <p class="lead">{x['onboarding.intro'].replace(/\n/g, ' ')}</p>
            <p class="ctas">
              <a class="btn dark" href={hue9.appStore}>
                {a.appStore} ↗
              </a>
            </p>
          </div>
          <div class="art">
            <span class="tile t1" style={`background:${rams[8]}`} />
            <span class="tile t2" style={`background:${rams[6]}`} />
            <Board palette="rams" seed={3} class="tilt" label={x['onboarding.welcome.promise']} />
          </div>
        </section>

        <section class="rule">
          <p class="dots" aria-hidden="true">
            {rams.map((c) => (
              <i style={`background:${c}`} />
            ))}
          </p>
          <p>{x['onboarding.welcome.promise']}</p>
        </section>

        <div class="duo">
          <section class="panel zen">
            <p class="kicker">{x['settings.zen_mode.title']}</p>
            <span class="moon" aria-hidden="true" />
            <Board palette="rams" mode="dark" seed={5} fill={0.3} class="zen-board" />
            <h2>{x['victory.zen.subtitle']}</h2>
            <p class="body">{x['settings.zen_mode.body']}</p>
          </section>

          <section class="panel daily">
            <p class="kicker">{x['daily_grid.title']}</p>
            <p class="date" aria-hidden="true">
              <span>{day}</span>
              <small>{dateLabel}</small>
            </p>
            <Board palette="spectrum" seed={11} fill={0.38} class="daily-board" />
            <h2>{x['onboarding.mode.daily.subtitle']}</h2>
            <p class="body">{x['paywall.feature.daily_grid.body']}</p>
          </section>
        </div>

        <section class="panel levels">
          <div class="copy">
            <p class="kicker">{x['onboarding.mode.offline.title']}</p>
            <h2>{x['onboarding.mode.offline.subtitle']}</h2>
          </div>
          <ol class="bands">
            {difficulties.map((d, i) => (
              <li class={`b${i}`}>
                <span>{d}</span>
                <span aria-hidden="true">↗</span>
              </li>
            ))}
          </ol>
        </section>

        <section class="panel moods">
          <p class="kicker">{x['paywall.feature.themes.title']}</p>
          <h2>{x['paywall.feature.themes.body']}</h2>
          <ul>
            {themes.map((th) => (
              <li>
                <span class="name">{th.name}</span>
                <Board palette={th.key} seed={th.seed} fill={0.45} symbols={th.key === 'obsidian'} label={th.name} />
              </li>
            ))}
          </ul>
        </section>

        <section class="panel see">
          <div class="copy">
            <p class="kicker">{x['onboarding.visual.symbols.title']}</p>
            <h2>{a.symbolsTitle}</h2>
            <p class="body">{x['onboarding.visual.symbols.body']}</p>
            <ul class="nine" aria-hidden="true">
              {PALETTES.spectrum.light.game.map((c, i) => (
                <li style={`color:${c}`}>
                  <Symbol value={i + 1} />
                </li>
              ))}
            </ul>
          </div>
          <Board palette="spectrum" symbols seed={13} fill={0.4} class="see-board" />
        </section>

        <section class="access">
          <p class="kicker">{a.featuresEyebrow}</p>
          <h2>{strip(a.principleTitle)}</h2>
          <p class="body">{a.principleBody}</p>
          <ul class="grid">
            {access.map((f) => (
              <li>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </li>
            ))}
            {tools.map((f) => (
              <li>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </li>
            ))}
          </ul>
          <p>
            <a class="more" href={a11yHref}>
              {hub.accessLink}
            </a>
          </p>
        </section>

        <section class="panel pro">
          <div class="copy">
            <p class="kicker">Hue9 Pro</p>
            <h2>{x['paywall.hero.line2']}</h2>
            <p class="body">{x['paywall.hero.line1']}</p>
            <p class="ctas">
              <a class="btn light" href={hue9.appStore}>
                {a.appStore} ↗
              </a>
            </p>
          </div>
          <ul>
            {pro.map((f) => (
              <li>
                <h3>{f.title}</h3>
                <p>{f.body}</p>
              </li>
            ))}
          </ul>
        </section>

        <section class="legal">
          <p class="kicker">{hub.heroEyebrow}</p>
          <ul class="grid">
            <li>
              <h3>{hub.privacyTitle}</h3>
              <p>{hub.privacyBody}</p>
              <a class="more" href={`${base}privacy/`}>
                {hub.privacyLink}
              </a>
            </li>
            <li>
              <h3>{hub.termsTitle}</h3>
              <p>{hub.termsBody}</p>
              <a class="more" href={`${base}terms/`}>
                {hub.termsLink}
              </a>
            </li>
            <li>
              <h3>{hub.accessTitle}</h3>
              <p>{hub.accessBody}</p>
              <a class="more" href={a11yHref}>
                {hub.accessLink}
              </a>
            </li>
          </ul>
        </section>
      </div>
    )
  }

  <section class="contact">
    <h2>{t.contactTitle}</h2>
    <p class="muted">{t.contactBody}</p>
    <p class="ctas">
      <a class="btn" href={mail(doc ? (page === 'privacy/' ? 'Privacy Request' : 'Legal Request') : 'Support')}>{t.contactButton} →</a>
      <a href={hue9.appStore}>{t.appStore}</a>
    </p>
  </section>
</AppPage>

<style>
  /* The app's own look: Inter instead of the site's monospace, paper background. */
  :global(:root.skin-hue9) {
    --bg: #f5f2ea;
    --line: #dfd9cb;
  }
  @media (prefers-color-scheme: dark) {
    :global(:root.skin-hue9:not([data-theme='light'])) {
      --bg: #1a1a1b;
      --line: #2e2e2c;
    }
  }
  :global(:root.skin-hue9[data-theme='dark']) {
    --bg: #1a1a1b;
    --line: #2e2e2c;
  }
  :global(:root.skin-hue9 main) {
    font-family: 'Inter Variable', 'Helvetica Neue', Arial, sans-serif;
    font-size: 16px;
    line-height: 1.55;
  }

  .h9 {
    --ink: #161616;
    --paper: #fdf8e8;
    --yellow: #ffde3a;
    --coral: #ff6f45;
    --lilac: #bcaef5;
    --lime: #d6f86b;
    --cobalt: #2b4ff0;
    display: grid;
    gap: 20px;
    padding-top: 24px;
  }
  .panel {
    position: relative;
    overflow: hidden;
    border-radius: 28px;
    padding: clamp(28px, 5vw, 56px);
    color: var(--ink);
  }
  h1,
  h2 {
    font-weight: 800;
    letter-spacing: -0.035em;
    margin: 0;
  }
  h1 {
    font-size: clamp(48px, 7.4vw, 96px);
    line-height: 0.95;
    margin-bottom: 24px;
  }
  h2 {
    font-size: clamp(30px, 4.2vw, 52px);
    line-height: 1.02;
  }
  h3 {
    font-size: 17px;
    font-weight: 700;
    margin: 0 0 6px;
  }
  .kicker {
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    margin: 0 0 20px;
  }
  .body {
    font-size: 17px;
    max-width: 520px;
    margin: 16px 0 0;
    opacity: 0.85;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin: 0;
  }
  .btn {
    display: inline-block;
    font-weight: 700;
    text-decoration: none;
    padding: 14px 24px;
    border-radius: 999px;
    background: var(--fg);
    color: var(--bg);
    transition: transform 0.15s;
  }
  .btn:hover {
    transform: translateY(-2px);
    color: var(--bg);
  }
  .btn.dark {
    background: var(--ink);
    color: #fff;
  }
  .btn.light {
    background: #fff;
    color: var(--ink);
  }

  /* Hero: solar yellow, oversized tilted board. */
  .hero {
    background: var(--yellow);
    display: grid;
    grid-template-columns: 1.05fr 1fr;
    align-items: center;
    gap: 40px;
    min-height: 560px;
  }
  .tag {
    display: flex;
    align-items: center;
    gap: 12px;
    font-weight: 800;
    font-size: 22px;
    letter-spacing: -0.02em;
    margin: 0 0 32px;
  }
  .tag img {
    border-radius: 11px;
  }
  .lead {
    font-size: 20px;
    max-width: 440px;
    margin: 0 0 32px;
  }
  .art {
    position: relative;
    margin-right: -12%;
  }
  .tilt {
    transform: rotate(-7deg);
  }
  .tile {
    position: absolute;
    z-index: 1;
    width: 18%;
    aspect-ratio: 1;
    border-radius: 22%;
    box-shadow: 0 16px 30px -14px rgb(0 0 0 / 0.5);
  }
  .t1 {
    left: -8%;
    top: 4%;
    transform: rotate(-14deg);
  }
  .t2 {
    right: 16%;
    bottom: -6%;
    transform: rotate(10deg);
  }

  .rule {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: center;
    gap: 12px 24px;
    padding: 28px 0;
    font-size: 19px;
    font-weight: 600;
    text-align: center;
  }
  .rule p {
    margin: 0;
  }
  .dots {
    display: flex;
    gap: 6px;
  }
  .dots i {
    width: 16px;
    height: 16px;
    border-radius: 5px;
    box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.12);
  }

  /* Zen and Daily Grid side by side. */
  .duo {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 20px;
  }
  .zen,
  .daily {
    display: flex;
    flex-direction: column;
    min-height: 640px;
  }
  .zen {
    background: var(--ink);
    color: #f5f2ea;
  }
  .zen .kicker {
    color: var(--lime);
  }
  .zen h2 {
    color: var(--lime);
    margin-top: auto;
  }
  .moon {
    position: absolute;
    right: -18%;
    top: 12%;
    width: 70%;
    aspect-ratio: 1;
    border-radius: 50%;
    background: var(--lilac);
  }
  .zen-board {
    position: relative;
    width: 82%;
    margin: 8px 0 40px -14%;
    transform: rotate(6deg);
  }
  .daily {
    background: var(--coral);
  }
  .date {
    display: flex;
    align-items: flex-start;
    gap: 16px;
    margin: -8px 0 0;
    color: var(--paper);
  }
  .date span {
    font-size: clamp(110px, 14vw, 180px);
    font-weight: 900;
    line-height: 0.85;
    letter-spacing: -0.06em;
  }
  .date small {
    writing-mode: vertical-rl;
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    color: var(--ink);
  }
  .daily-board {
    width: 74%;
    margin: -28px 0 36px 12%;
    transform: rotate(4deg);
  }
  .daily h2 {
    margin-top: auto;
  }

  /* Difficulties as angled banners. */
  .levels {
    background: var(--lilac);
    display: grid;
    grid-template-columns: 1fr 1.2fr;
    align-items: center;
    gap: 32px;
  }
  .bands {
    list-style: none;
    margin: 0 -12% 0 0;
    padding: 0;
    display: grid;
    gap: 18px;
  }
  .bands li {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 18px 14% 18px 28px;
    font-size: clamp(26px, 3.6vw, 44px);
    font-weight: 900;
    letter-spacing: -0.02em;
    text-transform: uppercase;
    transform: rotate(-4deg);
  }
  .b0 {
    background: var(--lime);
  }
  .b1 {
    background: var(--paper);
  }
  .b2 {
    background: var(--coral);
  }
  .b3 {
    background: var(--ink);
    color: #fff;
  }

  /* Four palettes. */
  .moods {
    background: var(--paper);
  }
  .moods h2 {
    max-width: 760px;
  }
  .moods ul {
    list-style: none;
    margin: 40px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
  }
  .name {
    display: block;
    font-weight: 800;
    font-size: 20px;
    margin-bottom: 12px;
  }

  /* Symbols on cobalt. */
  .see {
    background: var(--cobalt);
    color: #fff;
    display: grid;
    grid-template-columns: 1fr 1fr;
    align-items: center;
    gap: 40px;
  }
  .see .body {
    opacity: 0.9;
  }
  .nine {
    list-style: none;
    margin: 32px 0 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(9, 1fr);
    gap: 8px;
    max-width: 440px;
  }
  .nine li {
    display: grid;
    place-items: center;
    aspect-ratio: 1;
    background: #fff;
    border-radius: 22%;
  }
  .nine svg {
    width: 64%;
  }
  .see-board {
    transform: rotate(-4deg);
  }

  /* Accessibility, plain on the page background. */
  .access,
  .legal {
    padding: 72px 0 24px;
  }
  .access h2 {
    max-width: 820px;
  }
  .grid {
    list-style: none;
    margin: 40px 0 24px;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 16px;
  }
  .grid li {
    border: 1px solid var(--line);
    border-radius: 20px;
    padding: 24px;
  }
  .grid p {
    color: var(--muted);
    margin: 0 0 12px;
  }
  .more {
    font-weight: 700;
    text-decoration-color: var(--accent);
    text-decoration-thickness: 2px;
  }

  /* Pro. */
  .pro {
    background: var(--ink);
    color: #fff;
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 40px;
  }
  .pro .kicker {
    color: var(--yellow);
  }
  .pro .ctas {
    margin-top: 32px;
  }
  .pro ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0;
  }
  .pro li {
    padding: 16px 0;
    border-bottom: 1px solid rgb(255 255 255 / 0.15);
  }
  .pro li:last-child {
    border-bottom: 0;
  }
  .pro li p {
    margin: 0;
    opacity: 0.75;
  }

  .contact {
    padding: 72px 0 24px;
  }
  .contact h2 {
    font-size: clamp(26px, 3.4vw, 38px);
    margin-bottom: 12px;
  }
  .contact p {
    max-width: 640px;
  }
  .contact .ctas {
    margin-top: 24px;
  }

  @media (max-width: 860px) {
    .hero,
    .duo,
    .levels,
    .see,
    .pro {
      grid-template-columns: 1fr;
    }
    .hero {
      min-height: 0;
    }
    .art {
      margin: 0 -10% -18% 8%;
    }
    .zen,
    .daily {
      min-height: 0;
    }
    .bands {
      margin-right: -20%;
    }
    .moods ul {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
