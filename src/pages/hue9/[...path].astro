---
// Hue9's site: overview, privacy and terms in the six languages of the app's legal pages.
// Texts come from src/data/hue9.json, extracted from the original /hue9-legal and /hue9-accessibility pages.
import AppPage from '../../layouts/AppPage.astro';
import { HUE9_LANGS, appPaths } from '../../data/appSites';
import LegalDoc from '../../components/LegalDoc.astro';
import data from '../../data/hue9.json';
import { apps } from '../../data/apps';

const LANGS = HUE9_LANGS;

export const getStaticPaths = () => appPaths(HUE9_LANGS);

const { lang, page } = Astro.props as { lang: keyof typeof data.common; page: string };
const t = data.common[lang];
const hub = data.hub[lang];
const a = data.a11y[lang] as Record<string, string>;
const hue9 = apps.find((x) => x.name === 'Hue9')!;
const base = `/hue9/${lang === 'en' ? '' : `${lang.toLowerCase()}/`}`;
const a11yHref = `/hue9-accessibility/?lang=${lang}`;
const mail = (subject: string) => `mailto:davidcafor@gmail.com?subject=${encodeURIComponent(`Hue9 ${subject}`)}`;

const nav = [
  { label: t.navPrivacy, href: `${base}privacy/` },
  { label: t.navTerms, href: `${base}terms/` },
  { label: t.navAccessibility, href: a11yHref },
];

const features = ['symbols', 'voice', 'text', 'motion', 'contrast', 'zen'].map((k) => ({
  kicker: a[`${k}Kicker`],
  title: a[`${k}Title`],
  body: a[`${k}Body`],
}));

// Legal documents keep their numbered sections (p1Title/p1Body…).
const doc = page && (page === 'privacy/' ? data.privacy[lang] : data.terms[lang]) as Record<string, string> | '';
const sections = doc
  ? Array.from({ length: 10 }, (_, i) => i + 1)
      .filter((n) => doc[`p${n}Title`])
      .map((n) => ({ title: doc[`p${n}Title`], html: doc[`p${n}Body`] }))
  : [];
const strip = (s: string) => s.replace(/<br>/g, ' ');
---

<AppPage
  title={doc ? doc.pageTitle : `Hue9 — ${strip(a.heroTitle)}`}
  description={doc ? doc.pageDescription : a.heroIntro}
  app="hue9"
  {lang}
  langs={LANGS}
  {page}
  {nav}
  accent={{ light: '#e06a52', dark: '#f4866f' }}
>
  {
    doc ? (
      <LegalDoc
        eyebrow={doc.heroEyebrow}
        title={doc.heroTitle}
        intro={doc.heroIntro}
        chips={[doc.updated, doc.noTracking ?? doc.oneTime, doc.applies].filter(Boolean)}
        summary={[1, 2, 3].map((n) => ({ title: doc[`summary${n}Title`], body: doc[`summary${n}Body`] }))}
        notice={doc.notice}
        tocLabel={t.tableOfContents}
        {sections}
      />
    ) : (
      <>
        <section class="hero">
          <img src={hue9.icon} alt="" width="120" height="120" class="icon" />
          <p class="label">{a.footerTagline}</p>
          <h1>
            Hue9<span class="cursor" aria-hidden="true">_</span>
          </h1>
          <p class="claim" set:html={a.heroTitle} />
          <p class="intro">{a.heroIntro}</p>
          <p class="ctas mono">
            <a class="btn" href={hue9.appStore}>
              {a.appStore} →
            </a>
            <a href="#features">{a.explore}</a>
          </p>
        </section>

        <section class="principle">
          <p class="label">{a.principleEyebrow}</p>
          <h2 set:html={a.principleTitle} />
          <p class="muted">{a.principleBody}</p>
        </section>

        <section id="features">
          <p class="label">{a.featuresEyebrow}</p>
          <h2>{a.featuresTitle}</h2>
          <ul class="grid">
            {features.map((f, i) => (
              <li>
                <span class="mono kicker">
                  {String(i + 1).padStart(2, '0')} · {f.kicker}
                </span>
                <h3>{f.title}</h3>
                <p class="muted">{f.body}</p>
              </li>
            ))}
          </ul>
        </section>

        <section>
          <p class="label">{hub.heroEyebrow}</p>
          <h2 set:html={hub.heroTitle} />
          <ul class="grid cards">
            <li>
              <h3>{hub.privacyTitle}</h3>
              <p class="muted">{hub.privacyBody}</p>
              <a href={`${base}privacy/`}>{hub.privacyLink}</a>
            </li>
            <li>
              <h3>{hub.termsTitle}</h3>
              <p class="muted">{hub.termsBody}</p>
              <a href={`${base}terms/`}>{hub.termsLink}</a>
            </li>
            <li>
              <h3>{hub.accessTitle}</h3>
              <p class="muted">{hub.accessBody}</p>
              <a href={a11yHref}>{hub.accessLink}</a>
            </li>
          </ul>
        </section>
      </>
    )
  }

  <section class="contact">
    <h2>{t.contactTitle}</h2>
    <p class="muted">{t.contactBody}</p>
    <p class="ctas mono">
      <a class="btn" href={mail(doc ? (page === 'privacy/' ? 'Privacy Request' : 'Legal Request') : 'Support')}>{t.contactButton} →</a>
      <a href={hue9.appStore}>{t.appStore}</a>
    </p>
  </section>
</AppPage>

<style>
  section {
    padding-top: 96px;
  }
  .hero {
    padding-top: 56px;
    max-width: 820px;
  }
  .icon {
    display: block;
    border-radius: 26px;
    margin-bottom: 32px;
    box-shadow: 0 1px 0 var(--line), 0 18px 40px -24px rgb(0 0 0 / 0.35);
  }
  h1 {
    font-size: clamp(56px, 10vw, 112px);
    line-height: 0.95;
    letter-spacing: -0.04em;
    margin: 0 0 16px;
  }
  .cursor {
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .claim {
    font-size: clamp(22px, 3vw, 30px);
    line-height: 1.25;
    margin: 0 0 16px;
  }
  .intro {
    font-size: 17px;
    color: var(--muted);
    margin: 0 0 32px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 20px;
    margin: 0;
  }
  .btn {
    background: var(--fg);
    color: var(--bg);
    text-decoration: none;
    padding: 10px 18px;
  }
  .btn:hover {
    background: var(--accent);
    color: var(--bg);
  }
  h2 {
    font-size: clamp(24px, 3.4vw, 36px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 16px;
    max-width: 820px;
  }
  .principle p,
  .contact p {
    max-width: 720px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin: 40px 0 0;
    padding: 0;
    list-style: none;
    background: var(--line);
    border: 1px solid var(--line);
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  .grid li {
    background: var(--bg);
    padding: 28px;
  }
  .kicker {
    color: var(--accent);
  }
  h3 {
    font-size: 17px;
    margin: 12px 0 8px;
  }
  .grid p {
    margin: 0 0 12px;
  }
  .cards h3 {
    margin-top: 0;
  }
  .contact {
    padding-bottom: 24px;
  }
</style>
