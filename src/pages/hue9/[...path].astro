---
// /hue9/ is Hue9's original site (public/hue9/index.html, the same page as /hue9-accessibility),
// which switches language itself with ?lang=. These pages only send the language and legal
// URLs that /hue9 had for a while to their original equivalents.
import { HUE9_LANGS, appPaths } from '../../data/appSites';

export const getStaticPaths = () => appPaths(HUE9_LANGS).filter((p) => p.params.path); // '/hue9/' itself is static

const { lang, page } = Astro.props as { lang: string; page: string };
const to = page ? `/hue9-legal/${page.replace('/', '')}.html?lang=${lang}` : `/hue9/?lang=${lang}`;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <link rel="canonical" href={to} />
    <title>Hue9</title>
  </head>
  <body>
    <a href={to}>Hue9</a>
  </body>
</html>
