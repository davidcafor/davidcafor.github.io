---
import Base from '../layouts/Base.astro';
import { buildGrid, COLS, countryName, toCell } from '../lib/worldGrid';
import sales from '../data/sales.json';

const HOME = { label: 'a coruña ─', lon: -8.41, lat: 43.37 };

const SEA = ' ';
const LAND = ':';
const SOLD = '#';
const PIN = '@';

const sold = new Set(sales.countries.map((c) => c.code));
const latest = [...sales.countries].sort((a, b) => b.since.localeCompare(a.since))[0];

// Each cell becomes { ch, cls, code }; runs of identical cells are merged into one span.
type Cell = { ch: string; cls: string; code: string };
const grid = buildGrid();
const total = new Set(grid.flat().filter(Boolean)).size;
const pct = Math.round((sold.size / total) * 100);
const cells: Cell[][] = grid.map((row) =>
  row.map((code) =>
    !code ? { ch: SEA, cls: '', code } : sold.has(code) ? { ch: SOLD, cls: 'on', code } : { ch: LAND, cls: 'land', code },
  ),
);

const pin = toCell(HOME.lon, HOME.lat);
cells[pin.row][pin.col] = { ch: PIN, cls: 'pin', code: '' };
// Write the label into the sea to the west of the pin, if there is room.
const labelStart = pin.col - HOME.label.length;
if (labelStart >= 0 && grid[pin.row].slice(labelStart, pin.col).every((c) => !c)) {
  [...HOME.label].forEach((ch, i) => (cells[pin.row][labelStart + i] = { ch, cls: 'home', code: '' }));
}

const rows = cells.map((row) => {
  const runs: Cell[] = [];
  for (const c of row) {
    const last = runs.at(-1);
    if (last && last.cls === c.cls && last.code === c.code) last.ch += c.ch;
    else runs.push({ ...c });
  }
  return runs;
});

const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
const mapHtml = rows
  .map((runs) =>
    runs
      .map((r) =>
        !r.cls
          ? r.ch
          : r.code
            ? `<span class="${r.cls}" data-c="${r.code}" title="${esc(countryName(r.code))}">${r.ch}</span>`
            : `<span class="${r.cls}">${esc(r.ch)}</span>`,
      )
      .join(''),
  )
  .join('\n');

---

<Base title="Sales map · David Cardeña" description="Every country where someone has bought one of my apps." wide>
  <section class="intro">
    <h1 class="label">Sales map</h1>
    <p>Every <span class="on">#</span> is a country where someone has bought one of my apps. The map redraws itself as new countries join.</p>
    {sales.sample && <p class="sample mono">[ sample data · not real sales yet ]</p>}
  </section>

  <div class="layout">
    <figure class="map" role="img" aria-label={`World map with ${sold.size} countries highlighted`}>
      <pre aria-hidden="true" set:html={mapHtml} />
    </figure>

    <aside class="legend mono">
      <p class="cmd"><span class="prompt">$</span> sales --summary</p>
      <dl>
        <dt>countries</dt>
        <dd>
          <span class="big">{sold.size}</span><span class="muted">/{total}</span>
          <span class="muted"> · {pct}%</span>
        </dd>
        {
          latest && (
            <>
              <dt>latest</dt>
              <dd>
                <span class="on">#</span> {countryName(latest.code)}{' '}
                <span class="muted">· {latest.since}</span>
              </dd>
            </>
          )
        }
        <dt>home</dt>
        <dd><span class="pin">@</span> A Coruña, ES</dd>
        <dt>updated</dt>
        <dd class="muted">{sales.updated}</dd>
        <dt>cursor</dt>
        <dd class="hover muted">–</dd>
      </dl>
    </aside>
  </div>
</Base>

<style define:vars={{ cols: COLS }}>
  .intro {
    max-width: 640px;
    padding-top: 40px;
  }
  .intro p {
    margin: 0;
  }
  .sample {
    margin-top: 12px !important;
    color: var(--accent);
  }
  .layout {
    display: grid;
    gap: 40px;
    margin-top: 48px;
  }
  .map {
    margin: 0;
    container-type: inline-size;
  }
  pre {
    margin: 0;
    /* JetBrains Mono advances 0.6em per character: fit every column in the width. */
    font-size: calc(100cqi / (var(--cols) * 0.6));
    line-height: 1.2;
    color: var(--muted);
    user-select: none;
  }
  pre :global(.land) {
    color: var(--land);
    cursor: default;
  }
  .on,
  pre :global(.on) {
    color: var(--accent);
    font-weight: 700;
    cursor: default;
  }
  .pin {
    color: var(--fg);
    font-weight: 700;
  }
  pre :global(.pin) {
    color: var(--fg);
    font-weight: 700;
    animation: blink 1.6s steps(1) infinite;
  }
  pre :global(.home) {
    color: var(--muted);
  }
  pre :global(.hot) {
    color: var(--fg);
  }
  @keyframes blink {
    50% {
      opacity: 0.25;
    }
  }
  .cmd {
    margin: 0 0 16px;
    color: var(--muted);
  }
  .prompt {
    color: var(--accent);
  }
  dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(5, auto);
    justify-content: start;
    column-gap: 56px;
    row-gap: 6px;
    font-size: 13px;
  }
  dt {
    grid-row: 1;
  }
  dd {
    grid-row: 2;
  }
  dt {
    color: var(--muted);
  }
  dd {
    margin: 0;
    min-width: 0;
  }
  .big {
    font-size: 22px;
    line-height: 1;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 760px) {
    .layout {
      gap: 28px;
    }
    dl {
      grid-template-columns: 11ch 1fr;
      row-gap: 10px;
      align-items: baseline;
    }
    dt,
    dd {
      grid-row: auto;
    }
  }
</style>

<script>
  const map = document.querySelector('.map pre');
  const out = document.querySelector('.legend .hover');
  let current = '';

  const show = (code: string, name: string) => {
    if (code === current) return;
    map?.querySelectorAll('.hot').forEach((el) => el.classList.remove('hot'));
    current = code;
    if (code) map?.querySelectorAll(`[data-c="${code}"]`).forEach((el) => el.classList.add('hot'));
    if (out) out.textContent = name || '–';
  };

  map?.addEventListener('pointerover', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-c]');
    show(el?.dataset.c ?? '', el?.title ?? '');
  });
  map?.addEventListener('pointerleave', () => show('', ''));
</script>
