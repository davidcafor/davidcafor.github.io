---
import Base from '../layouts/Base.astro';
import { buildGrid, COLS, countryName, toCell } from '../lib/worldGrid';
import sales from '../data/sales.json';
import { appStoreCountries } from '../data/appStoreCountries';

const HOME = { label: 'A Coruña · home', lon: -8.41, lat: 43.37 };

const SEA = ' ';
const LAND = ':';
const SOLD = '#';

const sold = new Set(sales.countries.map((c) => c.code));
const bySince = [...sales.countries].sort((a, b) => a.since.localeCompare(b.since));
const first = bySince[0];
const latest = bySince.at(-1);
const thisYear = new Date().getFullYear().toString();
const newThisYear = sales.countries.filter((c) => c.since.startsWith(thisYear)).length;

// Each cell becomes { ch, cls, code }; runs of identical cells are merged into one span.
type Cell = { ch: string; cls: string; code: string };
const grid = buildGrid();
// Progress counts only where the App Store exists, so selling everywhere reads as 100%.
const total = appStoreCountries.length;
const soldInStore = appStoreCountries.filter((c) => sold.has(c)).length;
const pct = Math.round((soldInStore / total) * 100);
const cells: Cell[][] = grid.map((row) =>
  row.map((code) =>
    !code ? { ch: SEA, cls: '', code } : sold.has(code) ? { ch: SOLD, cls: 'on', code } : { ch: LAND, cls: 'land', code },
  ),
);

// Home is drawn as a dot over the map, centred on its cell.
const pin = toCell(HOME.lon, HOME.lat);
const pinPos = `left: ${((pin.col + 0.5) / COLS) * 100}%; top: ${((pin.row + 0.5) / grid.length) * 100}%;`;

const rows = cells.map((row) => {
  const runs: Cell[] = [];
  for (const c of row) {
    const last = runs.at(-1);
    if (last && last.cls === c.cls && last.code === c.code) last.ch += c.ch;
    else runs.push({ ...c });
  }
  return runs;
});

const esc = (t: string) => t.replace(/&/g, '&amp;').replace(/</g, '&lt;').replace(/"/g, '&quot;');
const mapHtml = rows
  .map((runs) =>
    runs
      .map((r) =>
        !r.cls
          ? r.ch
          : r.code
            ? `<span class="${r.cls}" data-c="${r.code}" title="${esc(countryName(r.code))}">${r.ch}</span>`
            : `<span class="${r.cls}">${esc(r.ch)}</span>`,
      )
      .join(''),
  )
  .join('\n');

---

<Base title="Sales map · David Cardeña" description="Every country where someone has bought one of my apps.">
  <section class="intro">
    <h1 class="label">Sales map</h1>
    <p>Every <span class="on">#</span> is a country where someone has bought one of my apps. The map redraws itself as new countries join.</p>
    {
      sales.error ? (
        <p class="sample mono">[ error loading data · showing {sales.sample ? 'sample' : 'last saved'} data ]</p>
      ) : (
        sales.sample && <p class="sample mono">[ sample data · not real sales yet ]</p>
      )
    }
  </section>

  <div class="layout">
    <figure class="map" role="img" aria-label={`World map with ${sold.size} countries highlighted`}>
      <pre aria-hidden="true" set:html={mapHtml} />
      <span class="home-pin" style={pinPos} tabindex="0" aria-label={HOME.label}>
        <span class="tag mono">{HOME.label}</span>
      </span>
    </figure>

    <aside class="legend mono">
      <p class="cmd"><span class="prompt">$</span> sales --summary</p>
      <dl>
        <dt>countries</dt>
        <dd>
          <span class="big">{soldInStore}</span><span class="muted">/{total}</span>
          <span class="muted"> · {pct}%</span>
        </dd>
        {
          latest && (
            <>
              <dt>newest</dt>
              <dd>
                <span class="on">#</span> {countryName(latest.code)}{' '}
                <span class="muted">· {latest.since}</span>
              </dd>
            </>
          )
        }
        {
          first && (
            <>
              <dt>first</dt>
              <dd>
                {countryName(first.code)} <span class="muted">· {first.since}</span>
              </dd>
            </>
          )
        }
        <dt>new in {thisYear}</dt>
        <dd>+{newThisYear}</dd>
        <dt>updated</dt>
        <dd class="muted">{sales.updated}</dd>
        <dt>cursor</dt>
        <dd class="hover muted">–</dd>
      </dl>
    </aside>
  </div>
</Base>

<style define:vars={{ cols: COLS }}>
  .intro {
    max-width: 640px;
    padding-top: 40px;
  }
  .intro p {
    margin: 0;
  }
  .sample {
    margin-top: 12px !important;
    color: var(--accent);
  }
  .layout {
    display: grid;
    gap: 40px;
    margin-top: 48px;
  }
  .map {
    margin: 0;
    container-type: inline-size;
  }
  pre {
    margin: 0;
    /* JetBrains Mono advances 0.6em per character: fit every column in the width. */
    font-size: calc(100cqi / (var(--cols) * 0.6));
    line-height: 1.2;
    color: var(--muted);
    user-select: none;
  }
  pre :global(.land) {
    color: var(--land);
    cursor: default;
  }
  .on,
  pre :global(.on) {
    color: var(--accent);
    font-weight: 700;
    cursor: default;
  }
  pre :global(.hot) {
    color: var(--fg);
  }
  .map {
    position: relative;
  }
  /* Home: a red dot with a pulsing ring; its label shows on hover or focus. */
  .home-pin {
    position: absolute;
    width: 10px;
    height: 10px;
    margin: -5px 0 0 -5px;
    border-radius: 50%;
    background: var(--pin);
    cursor: default;
    outline-offset: 4px;
  }
  .home-pin::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: 50%;
    border: 2px solid var(--pin);
    animation: pulse 1.8s ease-out infinite;
  }
  .tag {
    position: absolute;
    right: calc(100% + 10px);
    top: 50%;
    transform: translateY(-50%);
    white-space: nowrap;
    padding: 2px 8px;
    border: 1px solid var(--line);
    background: var(--bg);
    color: var(--fg);
    opacity: 0;
    pointer-events: none;
    transition: opacity 0.15s;
  }
  .home-pin:hover .tag,
  .home-pin:focus-visible .tag {
    opacity: 1;
  }
  @keyframes pulse {
    to {
      transform: scale(3);
      opacity: 0;
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .home-pin::after {
      animation: none;
    }
  }
  .cmd {
    margin: 0 0 16px;
    color: var(--muted);
  }
  .prompt {
    color: var(--accent);
  }
  dl {
    margin: 0;
    display: grid;
    grid-template-columns: repeat(6, auto);
    justify-content: start;
    column-gap: 56px;
    row-gap: 6px;
    font-size: 13px;
  }
  dt {
    grid-row: 1;
  }
  dd {
    grid-row: 2;
  }
  dt {
    color: var(--muted);
  }
  dd {
    margin: 0;
    min-width: 0;
  }
  /* Fixed width, one line: long names never resize or reflow the summary. */
  .hover {
    width: 30ch;
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .big {
    font-size: 22px;
    line-height: 1;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  @media (max-width: 760px) {
    .layout {
      gap: 28px;
    }
    dl {
      grid-template-columns: 11ch 1fr;
      row-gap: 10px;
      align-items: baseline;
    }
    dt,
    dd {
      grid-row: auto;
    }
    .hover {
      width: auto;
    }
  }
</style>

<script>
  const map = document.querySelector('.map pre');
  const out = document.querySelector('.legend .hover');
  let current = '';

  const show = (code: string, name: string) => {
    if (code === current) return;
    map?.querySelectorAll('.hot').forEach((el) => el.classList.remove('hot'));
    current = code;
    if (code) map?.querySelectorAll(`[data-c="${code}"]`).forEach((el) => el.classList.add('hot'));
    if (out) out.textContent = name || '–';
  };

  map?.addEventListener('pointerover', (e) => {
    const el = (e.target as HTMLElement).closest<HTMLElement>('[data-c]');
    show(el?.dataset.c ?? '', el?.title ?? '');
  });
  map?.addEventListener('pointerleave', () => show('', ''));
</script>
