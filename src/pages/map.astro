---
import Base from '../layouts/Base.astro';
import { buildDots, COLS, ROWS, countryName, toGrid } from '../lib/worldGrid';
import sales from '../data/sales.json';

const HOME = { name: 'A Coruña', lon: -8.41, lat: 43.37 };

const sold = new Set(sales.countries.map((c) => c.code));
const dots = buildDots();
const pin = toGrid(HOME.lon, HOME.lat);

const latest = [...sales.countries].sort((a, b) => b.since.localeCompare(a.since))[0];

const fmt = (iso: string) =>
  new Date(`${iso}T00:00:00Z`).toLocaleDateString('en-US', {
    month: 'short',
    day: 'numeric',
    year: 'numeric',
    timeZone: 'UTC',
  });

const byCountry = Map.groupBy(dots, (d) => d.code);
---

<Base title="Sales map · David Cardeña" description="Every country where someone has bought one of my apps." wide>
  <section class="intro">
    <h1 class="label">Sales map</h1>
    <p>Every highlighted country is somewhere someone has bought one of my apps. The map redraws itself as new countries join.</p>
    {sales.sample && <p class="sample mono">[ sample data · not real sales yet ]</p>}
  </section>

  <div class="layout">
    <figure class="map">
      <svg viewBox={`0 0 ${COLS} ${ROWS}`} role="img" aria-label={`World map with ${sold.size} countries highlighted`}>
        {
          [...byCountry].map(([code, list]) => (
            <g class={sold.has(code) ? 'on' : undefined}>
              <title>{countryName(code)}</title>
              {list.map((d) => (
                <rect x={d.x - 0.36} y={d.y - 0.36} width="0.72" height="0.72" rx="0.14" />
              ))}
            </g>
          ))
        }
        <g class="pin" transform={`translate(${pin.x} ${pin.y})`}>
          <title>{HOME.name}</title>
          <circle class="pulse" r="1.4" />
          <path d="M0 0 C -0.2 -0.9 -1.3 -1.6 -1.3 -2.7 A 1.3 1.3 0 1 1 1.3 -2.7 C 1.3 -1.6 0.2 -0.9 0 0 Z" />
          <circle class="hole" cy="-2.7" r="0.45" />
        </g>
      </svg>
    </figure>

    <aside class="legend mono">
      <dl>
        <div>
          <dt>Countries</dt>
          <dd class="big">{sold.size}</dd>
        </div>
        {
          latest && (
            <div>
              <dt>Latest unlocked</dt>
              <dd>
                <span class="swatch" aria-hidden="true" />
                {countryName(latest.code)}
                <span class="muted"> · {fmt(latest.since)}</span>
              </dd>
            </div>
          )
        }
        <div>
          <dt>Home</dt>
          <dd>
            <span class="pin-key" aria-hidden="true" />
            A Coruña, Spain
          </dd>
        </div>
        <div>
          <dt>Updated</dt>
          <dd class="muted">{fmt(sales.updated)}</dd>
        </div>
      </dl>
    </aside>
  </div>
</Base>

<style>
  .intro {
    max-width: 640px;
    padding-top: 40px;
  }
  .intro p {
    margin: 0;
  }
  .sample {
    margin-top: 12px !important;
    color: var(--accent);
  }
  .layout {
    display: grid;
    grid-template-columns: minmax(0, 1fr) 200px;
    gap: 40px;
    align-items: end;
    margin-top: 48px;
  }
  .map {
    margin: 0;
  }
  svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }
  rect {
    fill: var(--dot);
    transition: fill 0.2s;
  }
  .on rect {
    fill: var(--accent);
  }
  g:hover rect {
    fill: var(--muted);
  }
  .on:hover rect {
    fill: var(--fg);
  }
  .pin path {
    fill: var(--fg);
  }
  .pin .hole {
    fill: var(--bg);
  }
  .pulse {
    fill: none;
    stroke: var(--fg);
    stroke-width: 0.15;
    transform-origin: 0 0;
    animation: pulse 2.4s ease-out infinite;
  }
  @keyframes pulse {
    from {
      transform: scale(0.3);
      opacity: 0.9;
    }
    to {
      transform: scale(2.2);
      opacity: 0;
    }
  }
  dl {
    margin: 0;
    display: grid;
    gap: 22px;
  }
  dt {
    font-size: 11px;
    text-transform: uppercase;
    letter-spacing: 0.08em;
    color: var(--muted);
    margin-bottom: 4px;
  }
  dd {
    margin: 0;
    font-size: 13px;
  }
  .big {
    font-size: 32px;
    line-height: 1;
    font-weight: 600;
    font-variant-numeric: tabular-nums;
  }
  .swatch,
  .pin-key {
    display: inline-block;
    width: 9px;
    height: 9px;
    margin-right: 6px;
    border-radius: 2px;
    background: var(--accent);
  }
  .pin-key {
    border-radius: 50% 50% 50% 0;
    transform: rotate(-45deg);
    background: var(--fg);
  }
  @media (max-width: 760px) {
    .layout {
      grid-template-columns: 1fr;
      gap: 28px;
    }
    dl {
      grid-template-columns: 1fr 1fr;
    }
  }
</style>
