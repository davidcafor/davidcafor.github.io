---
// Oraia's site: overview with support, privacy and terms, in English and Spanish.
// Legal and support texts come from src/data/oraia.json, extracted from /oraia-legal.
import AppPage from '../../layouts/AppPage.astro';
import { ORAIA_LANGS, appPaths } from '../../data/appSites';
import LegalDoc from '../../components/LegalDoc.astro';
import data from '../../data/oraia.json';

const LANGS = ORAIA_LANGS;

// App Store page, once it is public.
const APP_STORE: string | null = null;

export const getStaticPaths = () => appPaths(ORAIA_LANGS);

const ui = {
  en: {
    privacy: 'Privacy',
    terms: 'Terms',
    toc: 'On this page',
    tagline: 'Daily prayer',
    features: [
      { kicker: 'Private', title: 'Your prayer stays yours.', body: 'No account, no ads and no third-party analytics. Prayer history, journal and intentions are stored on your device.' },
      { kicker: 'Daily', title: 'A gentle nudge, every day.', body: 'Reminders are scheduled on your iPhone with your permission. Widgets and Live Activities keep today’s prayer and your streak in sight.' },
      { kicker: 'Journal', title: 'Write what you carry.', body: 'Keep intentions and journal entries next to each prayer, and erase them whenever you want from Profile.' },
    ],
    support: 'Support',
    legal: 'Legal',
    privacyBody: 'What stays on your device, what Apple and RevenueCat process for purchases, and your rights.',
    termsBody: 'The app licence, Premium subscriptions and lifetime purchase, and how to manage them.',
    read: 'Read →',
    contact: 'Contact support',
  },
  es: {
    privacy: 'Privacidad',
    terms: 'Condiciones',
    toc: 'En esta página',
    tagline: 'Oración diaria',
    features: [
      { kicker: 'Privada', title: 'Tu oración es solo tuya.', body: 'Sin cuenta, sin anuncios y sin analítica de terceros. El historial, el diario y las intenciones se guardan en tu dispositivo.' },
      { kicker: 'Diaria', title: 'Un recordatorio amable, cada día.', body: 'Los recordatorios se programan en tu iPhone con tu permiso. Los widgets y las Live Activities te muestran la oración del día y tu racha.' },
      { kicker: 'Diario', title: 'Escribe lo que llevas dentro.', body: 'Guarda intenciones y entradas del diario junto a cada oración, y bórralas cuando quieras desde Perfil.' },
    ],
    support: 'Soporte',
    legal: 'Legal',
    privacyBody: 'Qué se queda en tu dispositivo, qué tratan Apple y RevenueCat en las compras y cuáles son tus derechos.',
    termsBody: 'La licencia de la app, las suscripciones Premium y la compra de por vida, y cómo gestionarlas.',
    read: 'Leer →',
    contact: 'Contactar con soporte',
  },
};

const { lang, page } = Astro.props as { lang: 'en' | 'es'; page: string };
const t = ui[lang];
const d = data[lang];
const base = `/oraia/${lang === 'en' ? '' : `${lang}/`}`;
const nav = [
  { label: t.privacy, href: `${base}privacy/` },
  { label: t.terms, href: `${base}terms/` },
];
const doc = page === 'privacy/' ? d.privacy : page === 'terms/' ? d.terms : null;
const support = d.index.sections.slice(0, -1); // the last one only links to the legal pages
const mail = 'mailto:davidcafor@gmail.com?subject=Oraia%20Support';
---

<AppPage
  title={doc ? `${doc.title} · Oraia` : `Oraia — ${d.index.eyebrow}`}
  description={doc ? `Oraia — ${doc.title}` : d.index.lead!}
  app="oraia"
  {lang}
  langs={LANGS}
  {page}
  {nav}
  accent={{ light: '#3c674b', dark: '#8fbf9c' }}
>
  {
    doc ? (
      <LegalDoc eyebrow={`Oraia · ${doc === d.privacy ? t.privacy : t.terms}`} title={doc.title} chips={[doc.lead!]} tocLabel={t.toc} sections={doc.sections} />
    ) : (
      <>
        <section class="hero">
          <p class="label">{d.index.eyebrow}</p>
          <h1>
            Oraia<span class="cursor" aria-hidden="true">_</span>
          </h1>
          <p class="claim">{t.tagline}</p>
          <p class="intro">{d.index.lead}</p>
          {APP_STORE && (
            <p class="ctas mono">
              <a class="btn" href={APP_STORE}>App Store →</a>
            </p>
          )}
        </section>

        <ul class="grid">
          {t.features.map((f, i) => (
            <li>
              <span class="mono kicker">
                {String(i + 1).padStart(2, '0')} · {f.kicker}
              </span>
              <h3>{f.title}</h3>
              <p class="muted">{f.body}</p>
            </li>
          ))}
        </ul>

        <section id="support">
          <p class="label">{t.support}</p>
          <h2>{d.index.title}</h2>
          <div class="support">
            {support.map((s) => (
              <div>
                <h3>{s.title}</h3>
                <div class="muted prose" set:html={s.html} />
              </div>
            ))}
          </div>
          <p class="ctas mono">
            <a class="btn" href={mail}>{t.contact} →</a>
          </p>
        </section>

        <section>
          <p class="label">{t.legal}</p>
          <ul class="grid cards">
            <li>
              <h3>{d.privacy.title}</h3>
              <p class="muted">{t.privacyBody}</p>
              <a href={`${base}privacy/`}>{t.read}</a>
            </li>
            <li>
              <h3>{d.terms.title}</h3>
              <p class="muted">{t.termsBody}</p>
              <a href={`${base}terms/`}>{t.read}</a>
            </li>
          </ul>
        </section>
      </>
    )
  }
</AppPage>

<style>
  section {
    padding-top: 96px;
  }
  .hero {
    padding-top: 72px;
    max-width: 820px;
  }
  h1 {
    font-size: clamp(56px, 10vw, 112px);
    line-height: 0.95;
    letter-spacing: -0.04em;
    margin: 0 0 16px;
  }
  .cursor {
    color: var(--accent);
    animation: blink 1.1s steps(1) infinite;
  }
  @keyframes blink {
    50% {
      opacity: 0;
    }
  }
  .claim {
    font-size: clamp(22px, 3vw, 30px);
    line-height: 1.25;
    margin: 0 0 16px;
    color: var(--accent);
  }
  .intro {
    font-size: 17px;
    color: var(--muted);
    margin: 0 0 32px;
    max-width: 640px;
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 20px;
    margin: 32px 0 0;
  }
  .btn {
    background: var(--fg);
    color: var(--bg);
    text-decoration: none;
    padding: 10px 18px;
  }
  .btn:hover {
    background: var(--accent);
    color: var(--bg);
  }
  h2 {
    font-size: clamp(24px, 3.4vw, 36px);
    line-height: 1.15;
    letter-spacing: -0.02em;
    margin: 0 0 32px;
  }
  .grid {
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 1px;
    margin: 72px 0 0;
    padding: 0;
    list-style: none;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .cards {
    margin-top: 0;
    grid-template-columns: repeat(2, 1fr);
  }
  @media (max-width: 860px) {
    .grid {
      grid-template-columns: 1fr;
    }
  }
  .grid li {
    background: var(--bg);
    padding: 28px;
  }
  .kicker {
    color: var(--accent);
  }
  h3 {
    font-size: 17px;
    margin: 12px 0 8px;
  }
  .cards h3 {
    margin-top: 0;
  }
  .grid p {
    margin: 0 0 12px;
  }
  .support {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 40px;
    max-width: 1100px;
  }
  .support h3 {
    margin-top: 0;
  }
  .prose :global(p) {
    margin: 0 0 12px;
  }
  .prose :global(a) {
    color: var(--fg);
    overflow-wrap: anywhere;
  }
</style>
