---
// Oraia's site: overview with support, privacy and terms, in English and Spanish.
// Its look follows the app's design system (Oraia/Core/DesignSystem): warm parchment,
// candle-light gold, serif type and capsule buttons.
// Feature copy is the app's own (Localizable.xcstrings); legal and support texts come from
// src/data/oraia.json, extracted from /oraia-legal.
import AppPage from '../../layouts/AppPage.astro';
import { ORAIA_LANGS, appPaths } from '../../data/appSites';
import LegalDoc from '../../components/LegalDoc.astro';
import data from '../../data/oraia.json';

// App Store page, once it is public.
const APP_STORE: string | null = null;

export const getStaticPaths = () => appPaths(ORAIA_LANGS);

const ui = {
  en: {
    privacy: 'Privacy',
    terms: 'Terms',
    toc: 'On this page',
    howItWorks: 'How Oraia Works',
    heroTitle: 'Make a little room\nfor prayer.',
    heroBody: 'A few quiet minutes each day.',
    todayTitle: 'A prayer ready for you, every day',
    todayBody: 'Open the app, pray at your own pace, done. No browsing a library first. Today already has something ready for you.',
    todayMoment: 'Morning offering',
    todayLine: 'Into your hands I place this day.',
    todayHow: 'Today always has one waiting, chosen for the time of day and the season of the year. It reads like song lyrics, and can be read aloud.',
    feelTitle: 'The right prayer, right when you need it',
    feelBody: 'Tell Oraia how you feel and it finds the prayer for you: rest, sleep, forgiveness, decisions.',
    feelQuestion: 'How are you feeling?',
    feelings: ["I can't sleep", 'Something worries me', "I'm grieving", 'I want to give thanks', 'Pray for family'],
    devotions: 'Devotions',
    devotionsTitle: 'The Rosary, Stations, and the Litany',
    devotionsBody: 'Explained before you begin and prayed step by step, like the Rosary.',
    rosary: ['Holy Rosary', 'Five mysteries of the life of Jesus, prayed bead by bead. About 20 minutes.'],
    stations: ['Stations of the Cross', 'Walk with Jesus to the cross in fourteen short stops. About 15 minutes.'],
    litany: ['Litany of Loreto', 'Explained before you begin and prayed step by step, like the Rosary.'],
    seasonTitle: 'The app knows what day it is',
    seasonBody: 'Advent, Lent, Holy Week, Guadalupe: the right content shows up on its own, on the right dates, without you having to go looking for it.',
    pathsTitle: 'Guided paths',
    pathsBody: 'Short guided paths, a few minutes a day.',
    diaryTitle: 'A diary for your prayer',
    diaryBody: "After praying, write or dictate what stayed with you, and keep a list of who you're praying for. It all stays on your iPhone.",
    diaryPrompt: 'What stayed with you from this prayer?',
    diarySample: "Today I'm grateful for a quiet morning and a call from my sister.",
    streakTitle: 'A gentle daily streak',
    streakBody: 'A gentle streak counts the days you pray. Miss one and you simply start again; milestones are celebrated along the way.',
    helps: 'Things that help',
    extras: [
      ['Gentle reminders', 'One reminder at the time you chose. Nothing more.'],
      ['Dictate your diary', "Speak instead of typing. It's turned into text on your iPhone whenever possible."],
      ['Mindful minutes', 'Your prayer time counts as mindful minutes in Health.'],
    ],
    premiumTitle: 'Free to start, deeper with Premium',
    premiumBody: "Today's prayer, your streak, your journal and the Rosary are always free.",
    premiumName: 'Oraia Premium',
    premiumList: ['The whole prayer library', 'Every guided path', 'Stations of the Cross and Litany'],
    premiumPlans: [
      ['Monthly', 'Cancel anytime in Settings.'],
      ['Annual', 'Best value'],
      ['Lifetime', 'Pay once, keep it forever'],
    ],
    support: 'Support',
    legal: 'Legal',
    privacyBody: 'What stays on your device, what Apple and RevenueCat process for purchases, and your rights.',
    termsBody: 'The app licence, Premium subscriptions and lifetime purchase, and how to manage them.',
    read: 'Read →',
    contact: 'Contact support',
  },
  es: {
    privacy: 'Privacidad',
    terms: 'Condiciones',
    toc: 'En esta página',
    howItWorks: 'Cómo funciona Oraia',
    heroTitle: 'Haz un pequeño espacio\npara la oración.',
    heroBody: 'Unos minutos de calma cada día.',
    todayTitle: 'Una oración preparada para ti, cada día',
    todayBody: 'Abre la app, reza a tu ritmo y listo. No necesitas buscar en la biblioteca: Hoy ya tiene una oración preparada para ti.',
    todayMoment: 'Ofrecimiento de la mañana',
    todayLine: 'En tus manos pongo este día.',
    todayHow: 'Hoy siempre tiene una esperándote, elegida según la hora y el tiempo del año. Se lee como la letra de una canción y también se puede escuchar en voz alta.',
    feelTitle: 'La oración justa, justo cuando la necesitas',
    feelBody: 'Dile a Oraia cómo te sientes y encontrará la oración para ti: descanso, sueño, perdón, decisiones.',
    feelQuestion: '¿Cómo te sientes?',
    feelings: ['No puedo dormir', 'Algo me preocupa', 'Estoy de duelo', 'Quiero dar gracias', 'Rezar por mi familia'],
    devotions: 'Devociones',
    devotionsTitle: 'El Rosario, el Vía Crucis y la Letanía',
    devotionsBody: 'Explicados antes de empezar y rezados paso a paso, como el Rosario.',
    rosary: ['Santo Rosario', 'Cinco misterios de la vida de Jesús, rezados cuenta a cuenta. Unos 20 minutos.'],
    stations: ['Vía Crucis', 'Acompaña a Jesús hasta la cruz en catorce paradas breves. Unos 15 minutos.'],
    litany: ['Letanía de Loreto', 'Explicados antes de empezar y rezados paso a paso, como el Rosario.'],
    seasonTitle: 'La app sabe qué día es',
    seasonBody: 'Adviento, Cuaresma, Semana Santa, Guadalupe: el contenido adecuado aparece en sus fechas, sin que tengas que buscarlo.',
    pathsTitle: 'Recorridos guiados',
    pathsBody: 'Recorridos guiados y breves, unos minutos al día.',
    diaryTitle: 'Un diario para tu oración',
    diaryBody: 'Después de rezar, escribe o dicta lo que te ha quedado y guarda una lista de las personas por las que rezas. Todo se queda en tu iPhone.',
    diaryPrompt: '¿Qué te ha quedado de esta oración?',
    diarySample: 'Hoy doy gracias por una mañana tranquila y una llamada de mi hermana.',
    streakTitle: 'Un seguimiento amable de tu constancia',
    streakBody: 'Una racha amable cuenta los días que rezas. Si fallas uno, simplemente vuelves a empezar, y los hitos se celebran por el camino.',
    helps: 'Cosas que ayudan',
    extras: [
      ['Recordatorios amables', 'Un recordatorio a la hora que elegiste. Nada más.'],
      ['Dicta tu diario', 'Habla en vez de escribir. Se convierte en texto en tu iPhone siempre que es posible.'],
      ['Minutos de atención plena', 'Tu tiempo de oración cuenta como minutos de atención plena en Salud.'],
    ],
    premiumTitle: 'Gratis para empezar, más profundo con Premium',
    premiumBody: 'La oración de hoy, tu racha, tu diario y el Rosario son siempre gratis.',
    premiumName: 'Oraia Premium',
    premiumList: ['Toda la biblioteca de oraciones', 'Todos los recorridos guiados', 'Vía Crucis y Letanía'],
    premiumPlans: [
      ['Mensual', 'Cancela cuando quieras en Ajustes.'],
      ['Anual', 'Mejor opción'],
      ['De por vida', 'Pagas una vez y es tuyo para siempre'],
    ],
    support: 'Soporte',
    legal: 'Legal',
    privacyBody: 'Qué se queda en tu dispositivo, qué tratan Apple y RevenueCat en las compras y cuáles son tus derechos.',
    termsBody: 'La licencia de la app, las suscripciones Premium y la compra de por vida, y cómo gestionarlas.',
    read: 'Leer →',
    contact: 'Contactar con soporte',
  },
};

const { lang, page } = Astro.props as { lang: 'en' | 'es'; page: string };
const t = ui[lang];
const d = data[lang];
const base = `/oraia/${lang === 'en' ? '' : `${lang}/`}`;
const nav = [
  { label: t.privacy, href: `${base}privacy/` },
  { label: t.terms, href: `${base}terms/` },
];
const doc = page === 'privacy/' ? d.privacy : page === 'terms/' ? d.terms : null;
const support = d.index.sections.slice(0, -1); // the last one only links to the legal pages
const mail = 'mailto:davidcafor@gmail.com?subject=Oraia%20Support';
const devotions = [t.rosary, t.stations, t.litany];
// Streak strip: a week of prayer, today lit.
const week = ['M', 'T', 'W', 'T', 'F', 'S', 'S'];
---

<AppPage
  title={doc ? `${doc.title} · Oraia` : `Oraia — ${t.heroBody}`}
  description={doc ? `Oraia — ${doc.title}` : `${t.heroTitle.replace('\n', ' ')} ${t.todayBody}`}
  app="oraia"
  {lang}
  langs={ORAIA_LANGS}
  {page}
  {nav}
  accent={{ light: '#875e1c', dark: '#d4a24c' }}
  skin="skin-oraia"
>
  {
    doc ? (
      <LegalDoc eyebrow={`Oraia · ${doc === d.privacy ? t.privacy : t.terms}`} title={doc.title} chips={[doc.lead!]} tocLabel={t.toc} sections={doc.sections} />
    ) : (
      <div class="or">
        <section class="hero">
          <img class="mark" src="/oraia/mark.png" alt="" width="180" height="180" />
          <p class="eyebrow">Oraia</p>
          <h1>{t.heroTitle}</h1>
          <p class="lead">{t.heroBody}</p>
          <p class="ctas">
            {APP_STORE && (
              <a class="pill solid" href={APP_STORE}>
                App Store
              </a>
            )}
            <a class="pill" href="#today">
              {t.howItWorks} ↓
            </a>
          </p>
        </section>

        <section id="today" class="split">
          <div>
            <h2>{t.todayTitle}</h2>
            <p class="body">{t.todayBody}</p>
            <p class="body soft">{t.todayHow}</p>
          </div>
          <figure class="card today-card">
            <p class="eyebrow">{t.todayMoment}</p>
            <blockquote>{t.todayLine}</blockquote>
            <p class="lines" aria-hidden="true">
              <i style="width: 82%" />
              <i style="width: 64%" />
              <i style="width: 74%" />
            </p>
          </figure>
        </section>

        <section class="feel">
          <p class="eyebrow">{t.feelQuestion}</p>
          <h2>{t.feelTitle}</h2>
          <p class="body center">{t.feelBody}</p>
          <ul class="chips">
            {t.feelings.map((f) => (
              <li>{f}</li>
            ))}
          </ul>
        </section>

        <section class="devotions">
          <p class="eyebrow">{t.devotions}</p>
          <h2>{t.devotionsTitle}</h2>
          <ul class="cards">
            {devotions.map(([title, body], i) => (
              <li class="card">
                <span class="roman" aria-hidden="true">
                  {['I', 'II', 'III'][i]}
                </span>
                <h3>{title}</h3>
                <p>{body}</p>
              </li>
            ))}
          </ul>
        </section>

        <section class="split">
          <div class="card season">
            <h2>{t.seasonTitle}</h2>
            <p class="body">{t.seasonBody}</p>
          </div>
          <div class="card season">
            <h2>{t.pathsTitle}</h2>
            <p class="body">{t.pathsBody}</p>
            <ol class="path" aria-hidden="true">
              {[1, 2, 3, 4, 5, 6, 7].map((n) => (
                <li class:list={{ done: n < 4, now: n === 4 }} />
              ))}
            </ol>
          </div>
        </section>

        <section class="split">
          <figure class="card diary-card">
            <p class="eyebrow">{t.diaryPrompt}</p>
            <p class="hand">{t.diarySample}</p>
          </figure>
          <div>
            <h2>{t.diaryTitle}</h2>
            <p class="body">{t.diaryBody}</p>
          </div>
        </section>

        <section class="split">
          <div>
            <h2>{t.streakTitle}</h2>
            <p class="body">{t.streakBody}</p>
          </div>
          <div class="card streak" aria-hidden="true">
            {week.map((_, i) => (
              <span class:list={{ lit: i < 5, today: i === 4 }} />
            ))}
          </div>
        </section>

        <section class="helps">
          <p class="eyebrow">{t.helps}</p>
          <ul class="cards">
            {t.extras.map(([title, body]) => (
              <li>
                <h3>{title}</h3>
                <p>{body}</p>
              </li>
            ))}
          </ul>
        </section>

        <section class="card premium">
          <div>
            <p class="eyebrow">{t.premiumName}</p>
            <h2>{t.premiumTitle}</h2>
            <p class="body">{t.premiumBody}</p>
            <ul class="ticks">
              {t.premiumList.map((p) => (
                <li>{p}</li>
              ))}
            </ul>
          </div>
          <ul class="plans">
            {t.premiumPlans.map(([name, note]) => (
              <li>
                <h3>{name}</h3>
                <p>{note}</p>
              </li>
            ))}
          </ul>
        </section>

        <section id="support" class="support-block">
          <p class="eyebrow">{t.support}</p>
          <h2>{d.index.title}</h2>
          <div class="support">
            {support.map((s) => (
              <div>
                <h3>{s.title}</h3>
                <div class="prose" set:html={s.html} />
              </div>
            ))}
          </div>
          <p class="ctas">
            <a class="pill solid" href={mail}>
              {t.contact}
            </a>
          </p>
        </section>

        <section class="legal">
          <p class="eyebrow">{t.legal}</p>
          <ul class="cards two">
            <li class="card">
              <h3>{d.privacy.title}</h3>
              <p>{t.privacyBody}</p>
              <a href={`${base}privacy/`}>{t.read}</a>
            </li>
            <li class="card">
              <h3>{d.terms.title}</h3>
              <p>{t.termsBody}</p>
              <a href={`${base}terms/`}>{t.read}</a>
            </li>
          </ul>
        </section>
      </div>
    )
  }
</AppPage>

<style>
  /* Oraia's palette (Assets.xcassets/Oraia*), serif type and candle-light backdrop. */
  :global(:root.skin-oraia) {
    --bg: #faf6ef;
    --fg: #2b2420;
    --muted: #6b5f4f;
    --line: #e8dcc8;
    --surface: #f2e9da;
    --glow: rgb(184 134 61 / 0.3);
  }
  @media (prefers-color-scheme: dark) {
    :global(:root.skin-oraia:not([data-theme='light'])) {
      --bg: #15120d;
      --fg: #f5eee2;
      --muted: #a79581;
      --line: #2f281e;
      --surface: #221d16;
      --glow: rgb(212 162 76 / 0.22);
    }
  }
  :global(:root.skin-oraia[data-theme='dark']) {
    --bg: #15120d;
    --fg: #f5eee2;
    --muted: #a79581;
    --line: #2f281e;
    --surface: #221d16;
    --glow: rgb(212 162 76 / 0.22);
  }
  :global(:root.skin-oraia body) {
    background:
      radial-gradient(900px 700px at 100% 0%, var(--glow), transparent 70%),
      radial-gradient(800px 600px at 0% 100%, color-mix(in srgb, var(--glow) 55%, transparent), transparent 70%) var(--bg);
    background-attachment: fixed;
  }
  :global(:root.skin-oraia main) {
    font-family: ui-serif, 'New York', 'Iowan Old Style', 'Palatino Linotype', Georgia, serif;
    font-size: 18px;
    line-height: 1.6;
  }

  .or {
    display: grid;
    gap: 120px;
    padding-bottom: 40px;
  }
  h1,
  h2,
  h3 {
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  h1 {
    font-size: clamp(42px, 6.4vw, 76px);
    line-height: 1.05;
    margin: 0 0 20px;
    white-space: pre-line;
  }
  h2 {
    font-size: clamp(28px, 3.6vw, 42px);
    line-height: 1.12;
    margin: 0 0 16px;
  }
  h3 {
    font-size: 21px;
    margin: 0 0 8px;
  }
  .eyebrow {
    font-family: -apple-system, 'Helvetica Neue', Arial, sans-serif;
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--accent);
    margin: 0 0 16px;
  }
  .body {
    color: var(--muted);
    max-width: 560px;
    margin: 0 0 14px;
  }
  .center {
    margin-inline: auto;
  }
  .soft {
    font-style: italic;
  }
  .card {
    background: color-mix(in srgb, var(--surface) 85%, transparent);
    border: 1px solid var(--line);
    border-radius: 28px;
    padding: clamp(24px, 4vw, 44px);
  }
  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 14px;
    margin: 32px 0 0;
  }
  .pill {
    font-family: -apple-system, 'Helvetica Neue', Arial, sans-serif;
    font-weight: 600;
    font-size: 16px;
    padding: 14px 28px;
    border-radius: 999px;
    border: 1px solid var(--accent);
    color: var(--accent);
    text-decoration: none;
  }
  .pill.solid {
    background: var(--accent);
    color: var(--bg);
    box-shadow: 0 10px 24px -10px var(--accent);
  }
  .pill:hover {
    background: var(--accent);
    color: var(--bg);
  }

  .hero {
    text-align: center;
    padding-top: 64px;
  }
  .mark {
    display: block;
    width: 160px;
    height: auto;
    margin: 0 auto 28px;
    filter: drop-shadow(0 0 40px var(--glow));
    animation: rise 1.2s cubic-bezier(0.2, 0.8, 0.2, 1) both;
  }
  @keyframes rise {
    from {
      opacity: 0;
      transform: scale(0.6) rotate(-20deg);
    }
  }
  @media (prefers-reduced-motion: reduce) {
    .mark {
      animation: none;
    }
  }
  .lead {
    font-size: 22px;
    color: var(--muted);
    margin: 0;
  }

  .split {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 56px;
    align-items: center;
  }
  .today-card {
    margin: 0;
    transform: rotate(1.5deg);
  }
  blockquote {
    margin: 0 0 28px;
    font-size: clamp(30px, 3.6vw, 44px);
    font-weight: 700;
    line-height: 1.15;
  }
  .lines {
    display: grid;
    gap: 12px;
    margin: 0;
  }
  .lines i {
    height: 10px;
    border-radius: 6px;
    background: var(--line);
  }

  .feel {
    text-align: center;
  }
  .feel h2 {
    max-width: 760px;
    margin-inline: auto;
  }
  .chips {
    list-style: none;
    padding: 0;
    margin: 32px auto 0;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 12px;
    max-width: 820px;
  }
  .chips li {
    padding: 10px 22px;
    border-radius: 999px;
    border: 1px solid var(--line);
    background: var(--surface);
  }
  .chips li:first-child {
    border-color: var(--accent);
    color: var(--accent);
  }

  .cards {
    list-style: none;
    padding: 0;
    margin: 36px 0 0;
    display: grid;
    grid-template-columns: repeat(3, 1fr);
    gap: 20px;
  }
  .cards.two {
    grid-template-columns: 1fr 1fr;
  }
  .cards p {
    color: var(--muted);
    margin: 0 0 12px;
  }
  .roman {
    display: block;
    font-size: 15px;
    letter-spacing: 0.2em;
    color: var(--accent);
    margin-bottom: 20px;
  }

  .season {
    align-self: stretch;
  }
  .path {
    list-style: none;
    display: flex;
    gap: 10px;
    padding: 0;
    margin: 28px 0 0;
  }
  .path li {
    width: 22px;
    height: 22px;
    border-radius: 50%;
    border: 2px solid var(--line);
  }
  .path .done {
    background: var(--accent);
    border-color: var(--accent);
  }
  .path .now {
    border-color: var(--accent);
    box-shadow: 0 0 0 6px var(--glow);
  }

  .diary-card {
    margin: 0;
    transform: rotate(-1.5deg);
  }
  .hand {
    font-size: 26px;
    font-style: italic;
    line-height: 1.4;
    margin: 0;
  }

  .streak {
    display: flex;
    justify-content: space-between;
    gap: 10px;
  }
  .streak span {
    flex: 1;
    aspect-ratio: 1;
    max-width: 52px;
    border-radius: 50%;
    border: 2px solid var(--line);
  }
  .streak .lit {
    background: color-mix(in srgb, var(--accent) 35%, transparent);
    border-color: transparent;
  }
  .streak .today {
    background: var(--accent);
    box-shadow: 0 0 24px var(--glow);
  }

  .helps .cards li {
    border-top: 1px solid var(--accent);
    padding-top: 20px;
  }

  .premium {
    display: grid;
    grid-template-columns: 1.3fr 1fr;
    gap: 48px;
    align-items: center;
  }
  .ticks {
    list-style: none;
    padding: 0;
    margin: 20px 0 0;
    display: grid;
    gap: 8px;
  }
  .ticks li::before {
    content: '✦ ';
    color: var(--accent);
  }
  .plans {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 16px;
  }
  .plans li {
    border: 1px solid var(--accent);
    border-radius: 20px;
    padding: 20px 24px;
    background: var(--bg);
  }
  .plans p {
    color: var(--muted);
    margin: 0;
  }

  .support-block .ctas {
    justify-content: flex-start;
  }
  .support {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(280px, 1fr));
    gap: 40px;
  }
  .prose {
    color: var(--muted);
  }
  .prose :global(p) {
    margin: 0 0 12px;
  }
  .prose :global(a) {
    color: var(--accent);
    overflow-wrap: anywhere;
  }
  .legal a {
    color: var(--accent);
    text-decoration: none;
  }

  @media (max-width: 860px) {
    .or {
      gap: 80px;
    }
    .split,
    .premium,
    .cards,
    .cards.two {
      grid-template-columns: 1fr;
    }
    .split {
      gap: 32px;
    }
  }
</style>
