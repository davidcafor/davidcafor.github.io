---
import '@fontsource-variable/jetbrains-mono';
import '../styles/global.css';
import ThemeToggle from '../components/ThemeToggle.astro';
import { site } from '../data/site';

interface Props {
  title?: string;
  description?: string;
  lang?: string;
  /** Path shown after ~/davidcafor in the header, e.g. "/hue9". */
  crumb?: string;
  /** Pages in other languages, for hreflang links. */
  alternates?: { lang: string; href: string }[];
  /** Accent colours for pages that carry an app's own brand. */
  accent?: { light: string; dark: string };
  /** Extra class on <html> for an app's own look, e.g. "skin-hue9". */
  skin?: string;
  /** Name after © in the footer; app pages show the app's name, never David's. */
  owner?: string;
}

const { title = site.name, description = site.role, lang = 'en', alternates = [], accent, skin, owner = site.name } = Astro.props;
const onMap = Astro.url.pathname.replace(/\/$/, '') === '/map';
const crumb = Astro.props.crumb ?? (onMap ? '/map' : '');
---

<!doctype html>
<html lang={lang} style={accent && `--app-light: ${accent.light}; --app-dark: ${accent.dark}`} class:list={[{ branded: accent }, skin]}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={new URL(Astro.url.pathname, Astro.site)} />
    <meta name="theme-color" content="#f0ece3" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#21211f" media="(prefers-color-scheme: dark)" />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    {alternates.map((a) => <link rel="alternate" hreflang={a.lang} href={new URL(a.href, Astro.site)} />)}
    <script is:inline>
      try {
        const t = localStorage.getItem('theme');
        if (t === 'light' || t === 'dark') document.documentElement.dataset.theme = t;
      } catch {}
    </script>
  </head>
  <body>
    <header class="wrap top">
      <a href="/" class="mono home"><span class="prompt">~/</span>{site.handle}{crumb}</a>
      <nav class="mono">
        <slot name="nav">{!onMap && <a href="/map" class="nav-link">map</a>}</slot>
        <ThemeToggle />
      </nav>
    </header>
    <main class="wrap">
      <slot />
    </main>
    <footer class="wrap foot mono muted">
      <span>© {new Date().getFullYear()} {owner}</span>
      <span>{site.location}</span>
    </footer>
  </body>
</html>

<style>
  :global(body) {
    min-height: 100vh;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
  }
  main {
    flex: 1;
    width: 100%;
  }
  nav {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 8px 18px;
  }
  .nav-link {
    color: var(--muted);
    text-decoration: none;
  }
  .nav-link:hover {
    color: var(--fg);
  }
  .prompt {
    color: var(--accent);
  }
  .top {
    width: 100%;
    display: flex;
    flex-wrap: wrap;
    gap: 12px 24px;
    justify-content: space-between;
    align-items: center;
    padding-top: 28px;
    padding-bottom: 28px;
  }
  .home {
    text-decoration: none;
  }
  .foot {
    width: 100%;
    display: flex;
    justify-content: space-between;
    gap: 16px;
    flex-wrap: wrap;
    padding-top: 28px;
    padding-bottom: 28px;
    margin-top: 72px;
    border-top: 1px solid var(--line);
  }
</style>
