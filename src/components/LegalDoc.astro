---
// A legal document (privacy policy, terms): heading, optional summary cards, contents and sections.
interface Props {
  eyebrow: string;
  /** May contain <br>. */
  title: string;
  intro?: string;
  chips?: string[];
  summary?: { title: string; body: string }[];
  notice?: string;
  tocLabel: string;
  sections: { title: string; html: string }[];
}

const { eyebrow, title, intro, chips = [], summary = [], notice, tocLabel, sections } = Astro.props;
---

<article class="doc">
  <header class="head">
    <p class="label">{eyebrow}</p>
    <h1 set:html={title} />
    {intro && <p class="intro" set:html={intro} />}
    {chips.length > 0 && <ul class="chips mono">{chips.map((c) => <li>{c}</li>)}</ul>}
  </header>

  {
    summary.length > 0 && (
      <ul class="summary">
        {summary.map((s, i) => (
          <li>
            <span class="num mono">0{i + 1}</span>
            <h2>{s.title}</h2>
            <p class="muted">{s.body}</p>
          </li>
        ))}
      </ul>
    )
  }
  {notice && <p class="notice" set:html={notice} />}

  <div class="body">
    <nav class="toc mono" aria-label={tocLabel}>
      <p class="muted">{tocLabel}</p>
      <ol>
        {sections.map((s, i) => (
          <li>
            <a href={`#s${i + 1}`}>{s.title}</a>
          </li>
        ))}
      </ol>
    </nav>
    <div class="sections">
      {
        sections.map((s, i) => (
          <section id={`s${i + 1}`}>
            <h2>
              <span class="num mono">{String(i + 1).padStart(2, '0')}</span>
              {s.title}
            </h2>
            <div class="prose" set:html={s.html} />
          </section>
        ))
      }
    </div>
  </div>
</article>

<style>
  .doc {
    padding-top: 48px;
  }
  .head {
    max-width: 760px;
  }
  h1 {
    font-size: clamp(32px, 5vw, 52px);
    line-height: 1.1;
    letter-spacing: -0.02em;
    margin: 0 0 20px;
  }
  .intro {
    font-size: 17px;
    color: var(--muted);
    margin: 0 0 24px;
  }
  .chips {
    display: flex;
    flex-wrap: wrap;
    gap: 8px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  .chips li {
    border: 1px solid var(--line);
    padding: 2px 10px;
    color: var(--muted);
  }
  .summary {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
    gap: 1px;
    margin: 56px 0 0;
    padding: 0;
    list-style: none;
    background: var(--line);
    border: 1px solid var(--line);
  }
  .summary li {
    background: var(--bg);
    padding: 24px;
  }
  .summary h2 {
    font-size: 17px;
    margin: 12px 0 8px;
  }
  .summary p {
    margin: 0;
  }
  .num {
    color: var(--accent);
  }
  .notice {
    margin: 24px 0 0;
    padding-left: 16px;
    border-left: 2px solid var(--accent);
    color: var(--muted);
    max-width: 760px;
  }
  .body {
    display: grid;
    grid-template-columns: 240px minmax(0, 760px);
    gap: 64px;
    margin-top: 72px;
  }
  .toc {
    position: sticky;
    top: 24px;
    align-self: start;
  }
  .toc p {
    margin: 0 0 12px;
  }
  .toc ol {
    margin: 0;
    padding: 0;
    list-style: none;
    display: grid;
    gap: 6px;
  }
  .toc a {
    color: var(--muted);
    text-decoration: none;
  }
  .toc a:hover {
    color: var(--fg);
  }
  section {
    scroll-margin-top: 24px;
    padding-bottom: 40px;
    margin-bottom: 40px;
    border-bottom: 1px solid var(--line);
  }
  section:last-child {
    border-bottom: 0;
  }
  section h2 {
    font-size: 20px;
    margin: 0 0 16px;
    display: flex;
    gap: 14px;
    align-items: baseline;
  }
  section h2 .num {
    font-size: 13px;
    font-weight: 400;
  }
  .prose :global(p),
  .prose :global(ul) {
    margin: 0 0 14px;
  }
  .prose :global(li) {
    margin-bottom: 6px;
  }
  .prose :global(a) {
    overflow-wrap: anywhere;
  }
  .prose :global(.provider-links) {
    display: flex;
    flex-wrap: wrap;
    gap: 6px 20px;
  }
  @media (max-width: 860px) {
    .body {
      grid-template-columns: 1fr;
      gap: 40px;
    }
    .toc {
      position: static;
    }
  }
</style>
