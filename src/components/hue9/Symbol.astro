---
// One of Hue9's nine symbols, in the app's order (ColorInputView.symbolName):
// circle, square, triangle, diamond, plus, cross, star, double bar, slash.
interface Props {
  value: number; // 1…9
  class?: string;
}
const { value, class: cls } = Astro.props;
---

<svg viewBox="0 0 24 24" class={cls} aria-hidden="true">
  {value === 1 && <circle cx="12" cy="12" r="8" fill="currentColor" />}
  {value === 2 && <rect x="5" y="5" width="14" height="14" rx="1.5" fill="currentColor" />}
  {value === 3 && <polygon points="12,3.5 21,20 3,20" fill="currentColor" stroke-linejoin="round" />}
  {value === 4 && <polygon points="12,2.5 21.5,12 12,21.5 2.5,12" fill="currentColor" />}
  {value === 5 && <path d="M12 4v16M4 12h16" stroke="currentColor" stroke-width="4.2" stroke-linecap="round" fill="none" />}
  {value === 6 && <path d="M5.5 5.5l13 13M18.5 5.5l-13 13" stroke="currentColor" stroke-width="4.2" stroke-linecap="round" fill="none" />}
  {value === 7 && <polygon points="12,2.5 14.8,8.7 21.5,9.3 16.4,13.8 17.9,20.5 12,17 6.1,20.5 7.6,13.8 2.5,9.3 9.2,8.7" fill="currentColor" stroke="currentColor" stroke-width="1" stroke-linejoin="round" />}
  {value === 8 && <path d="M8.5 4.5v15M15.5 4.5v15" stroke="currentColor" stroke-width="4" stroke-linecap="round" fill="none" />}
  {value === 9 && <path d="M17 4.5L7 19.5" stroke="currentColor" stroke-width="4.2" stroke-linecap="round" fill="none" />}
</svg>
