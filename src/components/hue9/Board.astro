---
// A Hue9 board drawn in HTML: a valid Sudoku solution with some cells given,
// painted with one of the app's real palettes (Hue9/Resources/Assets.xcassets).
import Symbol from './Symbol.astro';
import { PALETTES, type PaletteName } from '../../data/hue9Palettes';

interface Props {
  palette: PaletteName;
  /** Which variant of the palette: the app's light or dark colours. */
  mode?: 'light' | 'dark';
  /** Show symbols instead of colour tiles (Symbol Mode). */
  symbols?: boolean;
  /** Share of cells that are filled, 0…1. */
  fill?: number;
  seed?: number;
  class?: string;
  label?: string;
}

const { palette, mode = 'light', symbols = false, fill = 0.42, seed = 1, class: cls, label } = Astro.props;
const p = PALETTES[palette][mode];

// Pseudo-random but stable between builds.
const rand = (n: number) => {
  const x = Math.sin(n * 9301 + seed * 49297) * 233280;
  return x - Math.floor(x);
};
// Shuffle the nine values so every board looks different.
const order = [1, 2, 3, 4, 5, 6, 7, 8, 9].sort((a, b) => rand(a) - rand(b));
const cells = Array.from({ length: 81 }, (_, i) => {
  const r = Math.floor(i / 9);
  const c = i % 9;
  const v = order[(r * 3 + Math.floor(r / 3) + c) % 9];
  return rand(i + 100) < fill ? v : 0;
});
const style = [
  `--b-bg:${p.bg}`,
  `--b-thin:${p.thin}`,
  `--b-thick:${p.thick}`,
  `--b-empty:${p.empty}`,
  ...p.game.map((g, i) => `--g${i + 1}:${g}`),
].join(';');
---

<div class:list={['board', { symbols }, cls]} style={style} role="img" aria-label={label}>
  {
    cells.map((v, i) => (
      <span
        class:list={['cell', { r: Math.floor(i / 9) % 3 === 2 && i < 72, c: i % 3 === 2 && i % 9 !== 8 }]}
        style={v ? `--v:var(--g${v})` : undefined}
      >
        {v > 0 && (symbols ? <Symbol value={v} class="sym" /> : <i />)}
      </span>
    ))
  }
</div>

<style>
  .board {
    display: grid;
    grid-template-columns: repeat(9, 1fr);
    aspect-ratio: 1;
    background: var(--b-bg);
    border-radius: 6%;
    padding: 4%;
    box-shadow:
      0 1px 0 rgb(0 0 0 / 0.04),
      0 30px 60px -30px rgb(0 0 0 / 0.45);
  }
  .cell {
    position: relative;
    display: grid;
    place-items: center;
    border-right: 1px solid var(--b-thin);
    border-bottom: 1px solid var(--b-thin);
  }
  .cell:nth-child(9n) {
    border-right: 0;
  }
  .cell:nth-child(n + 73) {
    border-bottom: 0;
  }
  .cell.c {
    border-right: 2px solid var(--b-thick);
  }
  .cell.r {
    border-bottom: 2px solid var(--b-thick);
  }
  .cell i {
    width: 72%;
    aspect-ratio: 1;
    border-radius: 22%;
    background: var(--v);
    box-shadow: inset 0 -2px 0 rgb(0 0 0 / 0.12);
  }
  .board :global(.sym) {
    width: 62%;
    color: var(--v);
  }
</style>
