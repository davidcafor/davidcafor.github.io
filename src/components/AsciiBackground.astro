---
// Full-page animated ASCII background. Moving the pointer sends a ripple through it.
// Renders a single static frame when the user prefers reduced motion.
---

<pre class="ascii-bg mono" aria-hidden="true"></pre>

<style>
  .ascii-bg {
    position: fixed;
    inset: 0;
    z-index: -1;
    margin: 0;
    overflow: hidden;
    line-height: 1.2;
    color: var(--ascii);
    user-select: none;
    pointer-events: none;
    white-space: pre;
    -webkit-mask-image: radial-gradient(ellipse 60% 70% at 50% 45%, rgb(0 0 0 / 0.25), #000 85%);
    mask-image: radial-gradient(ellipse 60% 70% at 50% 45%, rgb(0 0 0 / 0.25), #000 85%);
  }
</style>

<script>
  const el = document.querySelector<HTMLPreElement>('.ascii-bg');

  if (el) {
    const CHARS = ' .·:-=+*#';
    const FRAME_MS = 1000 / 24;
    const reduced = matchMedia('(prefers-reduced-motion: reduce)').matches;
    let cols = 0;
    let rows = 0;
    let charW = 8;
    let charH = 16;
    let last = 0;
    const ripples: { x: number; y: number; t: number }[] = [];

    const measure = () => {
      const probe = document.createElement('span');
      probe.textContent = 'x'.repeat(10);
      el.append(probe);
      const rect = probe.getBoundingClientRect();
      probe.remove();
      charW = rect.width / 10 || 8;
      charH = parseFloat(getComputedStyle(el).lineHeight) || 16;
      cols = Math.ceil(innerWidth / charW) + 1;
      rows = Math.ceil(innerHeight / charH) + 1;
    };

    const frame = (time: number) => {
      const t = time / 1000;
      while (ripples.length && t - ripples[0].t > 2.5) ripples.shift();
      let out = '';
      for (let y = 0; y < rows; y++) {
        const ny = y / rows;
        for (let x = 0; x < cols; x++) {
          const nx = x / cols;
          let v =
            Math.sin(nx * 7 + t * 0.5) * 0.5 +
            Math.sin((nx + ny) * 5 - t * 0.35) * 0.35 +
            Math.sin(ny * 9 + t * 0.8 + nx * 3) * 0.25;

          for (const r of ripples) {
            const dx = (x - r.x) / 2;
            const dy = y - r.y;
            const age = t - r.t;
            const d = Math.sqrt(dx * dx + dy * dy);
            v += Math.max(0, 1 - Math.abs(d - age * 18) * 0.4) * (1 - age / 2.5);
          }

          const n = Math.min(1, Math.max(0, (v + 1.1) / 2.2));
          out += CHARS[Math.floor(n * (CHARS.length - 1))];
        }
        out += '\n';
      }
      el.textContent = out;
    };

    const loop = (time: number) => {
      if (!document.hidden && time - last >= FRAME_MS) {
        last = time;
        frame(time);
      }
      requestAnimationFrame(loop);
    };

    measure();
    addEventListener('resize', () => {
      measure();
      if (reduced) frame(0);
    });

    if (reduced) {
      frame(0);
    } else {
      let lastRipple = 0;
      addEventListener('pointermove', (e) => {
        const now = performance.now();
        if (now - lastRipple < 450) return;
        lastRipple = now;
        ripples.push({ x: e.clientX / charW, y: e.clientY / charH, t: now / 1000 });
      });
      requestAnimationFrame(loop);
    }
  }
</script>
